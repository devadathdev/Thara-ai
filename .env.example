# Firebase Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only AI secrets — NEVER prefix with NEXT_PUBLIC_
OPENROUTER_API_KEY=
GEMINI_API_KEY=

OPENROUTER_ORCHESTRATOR_MODEL=
OPENROUTER_GENERAL_MODEL=openrouter/free
OPENROUTER_CODING_MODEL=openrouter/free
OPENROUTER_REASONING_MODEL=openrouter/free
GEMINI_MODEL=gemini-3.1-flash-lite

# Server-side Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AES-256-GCM: base64 of exactly 32 random bytes. Server-only.
THARA_AES_KEY_B64=

NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Web browsing/search — server-only
TAVILY_API_KEY=

# Optional public dataset discovery
HUGGINGFACE_API_TOKEN=

# Low-latency path
THARA_FAST_MODEL=gemini-3.1-flash-lite

# Optional hybrid local inference (OpenAI-compatible chat-completions endpoint)
# Configure a trusted local gateway/VPN endpoint; do not expose an unauthenticated model port publicly.
THARA_LOCAL_MODEL_URL=
THARA_LOCAL_MODEL_NAME=local-model
THARA_LOCAL_MODEL_API_KEY=
THARA_PREFER_LOCAL=false

# Required for short-lived, mission-scoped approval tokens; use at least 32 random characters.
THARA_APPROVAL_SECRET=

# WebAuthn / Fingerprint Line Clear
THARA_LINE_CLEAR_SECRET=replace-with-at-least-32-random-characters
THARA_WEBAUTHN_RP_ID=your-domain.example
THARA_WEBAUTHN_ORIGIN=https://your-domain.example
