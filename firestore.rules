rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if own(uid);
      allow create: if own(uid);
      allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','settings','updatedAt']);
      allow delete: if false;
    }

    match /users/{uid}/messages/{messageId} {
      allow read: if own(uid);
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['role','content','createdAt'])
        && request.resource.data.role in ['user','assistant']
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 8000;
      allow update, delete: if false;
    }

    match /users/{uid}/memories/{memoryId} {
      allow read: if own(uid);
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['content','importance','createdAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 4000;
      allow update, delete: if false;
    }

    match /users/{uid}/missions/{missionId} {
      allow read: if own(uid);
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['id','title','goal','status','steps','createdAt','updatedAt','approvalRequired'])
        && request.resource.data.goal is string
        && request.resource.data.goal.size() <= 4000
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 20
        && request.resource.data.status in ['planned','awaiting_approval','running','completed','failed','cancelled'];
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['planned','awaiting_approval','running','completed','failed','cancelled'];
      allow delete: if false;
    }


    match /users/{uid}/tharaTelemetry/{eventId} {
      allow read: if own(uid);
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['createdAt','event','domains','messageLength','latencyMs','success'])
        && request.resource.data.createdAt is number
        && request.resource.data.event is string
        && request.resource.data.event.size() <= 100
        && request.resource.data.domains is list
        && request.resource.data.domains.size() <= 12
        && request.resource.data.messageLength is number
        && request.resource.data.messageLength <= 8000;
      allow update, delete: if false;
    }

    match /users/{uid}/evaluations/{evaluationId} {
      allow read: if own(uid);
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['task','score','latencyMs','createdAt','model','tags'])
        && request.resource.data.task is string
        && request.resource.data.task.size() <= 2000
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1
        && request.resource.data.latencyMs is number
        && request.resource.data.latencyMs >= 0;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}