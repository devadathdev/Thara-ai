    {
      "dot": "emerald",
      "title": "External dependencies",
      "items": [
        "Firebase provides authentication and Firestore-backed persistence.",
        "AI providers supply cloud inference; local inference is a fallback path.",
        "Research and satellite intelligence consume external data sources.",
        "Engineering tools/protocol adapters sit behind integration boundaries."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust & ownership",
      "items": [
        "THARA owns orchestration, policy, memory, research routing and telemetry.",
        "Sentinel owns permission and protected-action verification.",
        "The hardware gateway owns the physical-world boundary.",
        "Physical execution is not implied: gateway defaults to simulation and requires approval + Line Clear + a real adapter."
      ]
    }
