{
  "name": "thara-self-improving-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "build:debug": "next build --debug",
    "test:autonomy": "tsc --target ES2022 --module commonjs --moduleResolution node --strict --skipLibCheck --esModuleInterop --outDir .thara-test-build lib/orchestrator/autonomy.ts lib/orchestrator/mission.ts lib/orchestrator/approval.ts tests/autonomy.test.ts tests/mission.test.ts tests/approval.test.ts && node --test .thara-test-build/tests/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/bcryptjs": "2.4.6",
    "typescript": "^5.9.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "prisma": "6.19.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
